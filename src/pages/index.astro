---
import "../styles/main.css";
import hero from "../content/sections/hero.json";
import about from "../content/sections/about.json";
import services from "../content/sections/focus.json";
import approach from "../content/sections/approach.json";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Maru Psychotherapy</title>
    </head>
    <body>
        <header class="site-header" id="siteHeader">
            <div class="nav-container">
                <a
                    href="#top"
                    class="site-logo"
                    id="logoLink"
                    aria-label="Maru Psychotherapy">maru</a
                >
                <nav class="site-nav">
                    <a href="#about">About</a>
                    <a href="#services">Services</a>
                    <a href="#location">Location</a>
                    <a href="#faqs">FAQs</a>
                    <a href="#consultation">Contact</a>
                </nav>
            </div>
        </header>

        <!-- Hero Section -->
        <section class="hero">
            <div class="container">
                <p class="badge">Accepting New Clients</p>
                <h1>
                    {hero.headlinePre}<mark class="highlight"
                        >{hero.headlineHighlight}</mark
                    >{hero.headlinePost}
                </h1>
                <p>{hero.subheadline}</p>
                <a
                    href={hero.buttonUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn"
                >
                    {hero.buttonText}
                </a>
            </div>
        </section>

        <!-- About Section -->
        <section id="about">
            <div class="container">
                <div class="avatar-container">
                    <div class="avatar-circle">
                        <img src={about.aboutImage} alt={about.aboutTitle} />
                    </div>
                </div>
                <h2>{about.aboutTitle}</h2>
                <p class="section-subhead">{about.aboutSubtitle}</p>
                <hr class="section-divider" />
                <p>{about.aboutBio}</p>

                {
                    about.aboutEducation && about.aboutEducation.length > 0 && (
                        <>
                            <p class="label">Education</p>
                            <ul>
                                {about.aboutEducation.map((degree) => (
                                    <li class="small-text">{degree}</li>
                                ))}
                            </ul>
                        </>
                    )
                }
            </div>
        </section>

        <!-- Areas of Focus Section -->
        <section id="services">
            <div class="container">
                <h2>{services.title}</h2>
                <p class="section-subhead">{services.subtitle}</p>
                <hr class="section-divider" />
                <ul class="item-list">
                    {
                        services.items &&
                            services.items.map((item) => (
                                <li>
                                    {item.svgPath && (
                                        <svg
                                            class="list-icon"
                                            aria-hidden="true"
                                            xmlns="http://www.w3.org/2000/svg"
                                            viewBox="0 0 640 640"
                                        >
                                            <path d={item.svgPath} />
                                        </svg>
                                    )}
                                    <div>
                                        <h3>{item.title}</h3>
                                        <p class="small-text">
                                            {item.description}
                                        </p>
                                    </div>
                                </li>
                            ))
                    }
                </ul>
            </div>
        </section>

        <!-- Approach Section -->
        <section id="approach">
            <div class="container">
                <h2>{approach.title}</h2>
                <p class="section-subhead">{approach.subtitle}</p>
                <hr class="section-divider" />
                <ul class="item-list">
                    {
                        approach.items &&
                            approach.items.map((item) => (
                                <li>
                                    {item.svgPath && (
                                        <svg
                                            class="list-icon"
                                            aria-hidden="true"
                                            xmlns="http://www.w3.org/2000/svg"
                                            viewBox="0 0 640 640"
                                        >
                                            <path d={item.svgPath} />
                                        </svg>
                                    )}
                                    <div>
                                        <h3>{item.title}</h3>
                                        <p class="small-text">
                                            {item.description}
                                        </p>
                                    </div>
                                </li>
                            ))
                    }
                </ul>
            </div>
        </section>

        <!-- Testimonial -->
        <section class="testimonial-section">
            <div class="container">
                <figure class="testimonial">
                    <blockquote>
                        <h3>
                            Alice is a calming, welcoming presence that offers
                            unique insight for the Asian-American community.
                        </h3>
                    </blockquote>
                    <figcaption class="testimonial-author">
                        <span class="label">Sade Ferrier</span>
                        <span class="small-text"
                            >Marriage &amp; Family Therapist, LMFT</span
                        >
                    </figcaption>
                </figure>
            </div>
        </section>

        <!-- Location & Availability -->
        <section id="location">
            <div class="container">
                <h2>Location &amp; Availability</h2>
                <p class="section-subhead">
                    Telehealth statewide &amp; in-person in Atlanta
                </p>
                <hr class="section-divider" />
                <p>
                    Accepting new clients for virtual therapy statewide across
                    Georgia, with in-person appointments coming soon to Atlanta.
                    Scheduling availability from 8:00 AM to 7:00 PM.
                </p>

                <p class="label">Address</p>
                <p class="small-text">
                    In-person office opening soon in Atlanta.
                </p>

                <p class="label">Rate</p>
                <p class="small-text">
                    $200 per 50-minute session.<br />
                    If fee structure is a potential barrier to working together, please
                    ask about sliding scale availability during our initial outreach.
                </p>

                <p class="label">Insurance</p>
                <p class="small-text">
                    I am out-of-network and do not bill insurance directly.
                    However, many insurance plans offer out-of-network benefits
                    that reimburse a portion of therapy costs.
                </p>
            </div>
        </section>

        <!-- FAQs -->
        <section id="faqs">
            <div class="container">
                <h2>FAQs</h2>
                <p class="section-subhead">Frequently asked questions</p>
                <hr class="section-divider" />

                <details>
                    <summary>How do I get started?</summary>
                    <p class="small-text">
                        Schedule a consultation via the button below and we will
                        connect at your scheduled time. During our consultation,
                        we will discuss your goals, answer any questions, and
                        determine the best path forward - whether that means
                        scheduling an initial session or connecting you with a
                        trusted colleague.
                    </p>
                    <p class="small-text">
                        If you prefer email, you can reach me directly at <a
                            href="mailto:admin@marupsychotherapy.com"
                            >admin@marupsychotherapy.com</a
                        >
                    </p>
                </details>

                <details>
                    <summary
                        >What is your session fee and payment options?</summary
                    >
                    <p class="small-text">
                        My standard fee for individual therapy is $200 per
                        50-minute session, and I accept all major credit, HSA,
                        and FSA cards.
                    </p>
                    <p class="small-text">
                        Because financial concerns shouldn't be the only barrier
                        to getting support, I offer a limited number of sliding
                        scale rates based on need and current availability.
                        Please don't hesitate to reach out to discuss what
                        options may be available.
                    </p>
                </details>

                <details>
                    <summary>Do you accept insurance?</summary>
                    <p class="small-text">
                        I am out-of-network and do not bill insurance directly.
                        However, many insurance plans offer out-of-network
                        benefits that reimburse a portion of therapy costs.
                    </p>
                    <p class="small-text">
                        Upon request, I can provide you with a monthly statement
                        called a Superbill to submit directly to your insurance
                        company. I recommend calling the member services number
                        on the back of your insurance card prior to our first
                        appointment to ask:
                    </p>
                    <ul class="small-text">
                        <li>
                            Does my plan cover out-of-network mental health
                            services?
                        </li>
                        <li>
                            What percentage of the session cost is reimbursed?
                        </li>
                        <li>
                            What is my out-of-network deductible, and has it
                            been met?
                        </li>
                    </ul>
                </details>

                <details>
                    <summary>What does maru mean?</summary>
                    <p class="small-text">
                        In traditional Korean architecture, Maru (마루) refers
                        to the central wooden floor at the core of a home: an
                        open space designed for rest, gathering, and reflection.
                        The word also denotes a summit or ridge, representing
                        growth and perspective.
                    </p>
                    <p class="small-text">
                        Maru Psychotherapy is built on these two principles:
                        providing a stable, structured space to process
                        emotional distress, along with the support needed to
                        achieve long-term change, insight, and resilience.
                    </p>
                </details>

                <details>
                    <summary
                        >How do I know a therapist is the right fit for me?</summary
                    >
                    <p class="small-text">
                        Finding the right therapist is essential to making
                        meaningful progress. For therapy to work well, you
                        should feel understood, supported, and comfortable.
                    </p>
                    <p class="small-text">
                        To help us explore fit, I offer free consultations. This
                        call or email is an opportunity to discuss what brings
                        you to therapy, learn more about my approach, and ask
                        any questions you have.
                    </p>
                    <p class="small-text">
                        Taking a moment beforehand to reflect on the goals you
                        hope to achieve in therapy can help us make the most of
                        our conversation.
                    </p>
                </details>

                <details>
                    <summary>How often should I attend therapy?</summary>
                    <p class="small-text">
                        Frequency depends on your specific goals, symptom
                        intensity, overall treatment plan, and schedule.
                    </p>
                    <p class="small-text">
                        I generally recommend starting with weekly sessions
                        until your symptoms feel more manageable, at which point
                        we can reassess and transition to biweekly, monthly, or
                        as-needed sessions. We will discuss the ideal cadence
                        during your consultation and adjust as your needs
                        evolve.
                    </p>
                </details>

                <details>
                    <summary>When is therapy recommended?</summary>
                    <p class="small-text">
                        Psychotherapy is beneficial for anyone navigating
                        persistent relationship patterns, depression,
                        dysregulated anxiety or anger, loss, disenfranchised
                        grief, or family-of-origin dynamics.
                    </p>
                    <p class="small-text">
                        It also provides meaningful support for identity
                        exploration, substance use concerns, and recurring
                        challenges that feel stuck or unresolved.
                    </p>
                </details>

                <details>
                    <summary>What is Psychodynamic Psychotherapy?</summary>
                    <p class="small-text">
                        Psychodynamic therapy is an insight-oriented clinical
                        approach grounded in psychoanalytic principles. It
                        operates on the premise that current psychological
                        distress, behavioral patterns, and interpersonal
                        difficulties are frequently mediated by unconscious
                        mental processes, internalized developmental
                        experiences, and maladaptive defense mechanisms.
                    </p>
                    <p class="small-text">
                        Rather than focusing exclusively on short-term symptom
                        management, psychodynamic treatment involves examining
                        recurring emotional themes, unresolved psychological
                        conflicts, and relational dynamics. By fostering insight
                        and integrating unconscious material into conscious
                        awareness, this methodology facilitates structural
                        emotional processing and long-term psychological
                        resilience.
                    </p>
                </details>

                <details>
                    <summary>What is EMDR and Flash Technique?</summary>
                    <p class="small-text">
                        EMDR is an evidence-based psychotherapy designed to
                        resolve the psychological and physiological impact of
                        trauma and adverse life events. Grounded in the Adaptive
                        Information Processing (AIP) model, EMDR utilizes
                        bilateral stimulation, such as side-to-side eye
                        movements or tactile taps to unlock unprocessed
                        memories, reduce somatic distress, and help the brain
                        re-encode traumatic experiences into adaptive memory
                        networks.
                    </p>
                    <p class="small-text">
                        Flash Technique is an advanced, evidence-based trauma
                        intervention designed to reduce the distress of
                        traumatic memories without requiring clients to
                        consciously re-experience them. Grounded in
                        neurobiological principles of memory reconsolidation,
                        this modality pairs a positive engaging focus with
                        rapid, subconscious memory processing. It offers an
                        efficient, low-distress path to processing intense
                        trauma, grief, or phobias while keeping the nervous
                        system completely regulated.
                    </p>
                </details>
            </div>
        </section>

        <!-- Schedule Consultation -->
        <section id="consultation" class="section-schedule">
            <div class="container">
                <h2>Schedule Free Consultation</h2>
                <p class="section-subhead">
                    Get in touch via scheduled call or email
                </p>
                <hr class="section-divider" />

                <p>
                    During our consultation, we'll discuss what brings you to
                    therapy, learn more about my approach, and answer any
                    questions you have. Choose a time below that works for you,
                    or feel free to email me directly at <a
                        href="mailto:admin@marupsychotherapy.com"
                        >admin@marupsychotherapy.com</a
                    >
                </p>

                <p class="small-text">
                    If you require immediate psychiatric assistance, please call
                    911 or go to your nearest emergency room and request a
                    mental health consult. You can also contact the Georgia
                    Crisis and Access Line at 1-800-815-4225, the Crisis Text
                    Line by texting "HOME" to 741741, or dial 988 to reach the
                    National Suicide and Crisis Lifeline.
                </p>

                <a
                    href="https://calendly.com/marupsychotherapy/15-minute-consultation"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn">Schedule Free Phone Consultation</a
                >
            </div>
        </section>

        <footer>
            <div class="container">
                <p class="label">Contact</p>
                <address>
                    <a
                        class="small-text"
                        href="mailto:admin@marupsychotherapy.com"
                        >admin@marupsychotherapy.com</a
                    >
                </address>

                <p class="label">Follow</p>
                <a
                    class="small-text"
                    href="https://instagram.com/maru_psychotherapy"
                    target="_blank"
                    rel="noopener">Instagram</a
                >

                <p class="xsmall-text">
                    &copy; <span id="year"></span> Maru Psychotherapy LLC. All rights
                    reserved.
                </p>
            </div>
        </footer>

        <script>
            // Dynamic copyright year
            document.getElementById("year").textContent =
                new Date().getFullYear();

            // Sticky header shadow effect
            const siteHeader = document.getElementById("siteHeader");
            window.addEventListener("scroll", () => {
                if (window.scrollY > 10) {
                    siteHeader.classList.add("scrolled");
                } else {
                    siteHeader.classList.remove("scrolled");
                }
            });

            // Smooth scroll for logo (back to top)
            document
                .getElementById("logoLink")
                .addEventListener("click", (e) => {
                    e.preventDefault();
                    window.scrollTo({
                        top: 0,
                        behavior: "smooth",
                    });
                });

            // Smooth scroll for site nav without changing URL hash
            document.querySelectorAll(".site-nav a").forEach((anchor) => {
                anchor.addEventListener("click", function (e) {
                    e.preventDefault();
                    const targetId = this.getAttribute("href");
                    const targetSection = document.querySelector(targetId);

                    if (targetSection) {
                        targetSection.scrollIntoView({
                            behavior: "smooth",
                        });
                    }
                });
            });
        </script>
    </body>
</html>
