---
import "../styles/main.css";
import { marked } from "marked";
import site from "../content/sections/site.json";
import hero from "../content/sections/hero.json";
import about from "../content/sections/about.json";
import focus from "../content/sections/focus.json";
import approach from "../content/sections/approach.json";
import location from "../content/sections/location.json";
import faqs from "../content/sections/faqs.json";
import consultation from "../content/sections/consultation.json";
import footer from "../content/sections/footer.json";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{site.siteTitle}</title>
        <link rel="canonical" href="https://marupsychotherapy.com/" />
        <meta name="description" content={site.siteDescription} />
        <meta property="og:title" content={site.siteTitle} />
        <meta property="og:description" content={site.siteDescription} />
        <meta property="og:type" content="website" />

        <!-- Editable Favicon Links -->
        <link rel="icon" type="image/svg+xml" href={`${site.faviconSvg}`} />
        <link rel="shortcut icon" href={`${site.faviconIco}`} />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href={`${site.appleTouchIcon}`}
        />

        <!-- Fonts & Styles -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Karla:ital,wght@0,400..800;1,400..800&display=swap"
            rel="stylesheet"
            media="print"
            onload="this.media='all'"
        />
        <noscript>
            <link
                href="https://fonts.googleapis.com/css2?family=Karla:ital,wght@0,400..800;1,400..800&display=swap"
                rel="stylesheet"
            />
        </noscript>
    </head>

    <body>
        <header class="site-header" id="siteHeader">
            <div class="nav-container">
                <a
                    href="#top"
                    class="site-logo"
                    id="logoLink"
                    aria-label="Maru Psychotherapy">maru</a
                >
                <nav class="site-nav">
                    <a href="#about">About</a>
                    <a href="#services">Services</a>
                    <a href="#location">Location</a>
                    <a href="#faqs">FAQs</a>
                    <a href="#consultation">Contact</a>
                </nav>
            </div>
        </header>

        <!-- Hero Section -->
        <section id="hero">
            <div class="container">
                <p class="badge">Accepting New Clients</p>
                <h1>
                    {hero.headlinePre}
                    <span class="highlight">{hero.headlineHighlight}</span>
                    {hero.headlinePost}
                </h1>
                <p class="hero-subhead">{hero.subheadline}</p>
                <div class="hero-cta">
                    <a href={hero.buttonUrl} class="btn">{hero.buttonText}</a>
                </div>
            </div>
        </section>

        <!-- About Section -->
        <section id="about">
            <div class="container">
                <div class="avatar-container">
                    <div class="avatar-circle">
                        <img src={about.image} alt={about.title} />
                    </div>
                </div>
                <h2>{about.title}</h2>
                <p class="section-subhead">{about.subtitle}</p>
                <hr class="section-divider" />
                <p>{about.bio}</p>

                {
                    about.listBlocks &&
                        about.listBlocks.map(
                            (block) =>
                                block.items &&
                                block.items.length > 0 && (
                                    <>
                                        <p class="label">{block.heading}</p>
                                        <ul>
                                            {block.items.map((listItem) => (
                                                <li class="small-text">
                                                    {listItem.item}
                                                </li>
                                            ))}
                                        </ul>
                                    </>
                                ),
                        )
                }
            </div>
        </section>

        <!-- Areas of Focus Section -->
        <section id="services">
            <div class="container">
                <h2>{focus.title}</h2>
                <p class="section-subhead">{focus.subtitle}</p>
                <hr class="section-divider" />
                <ul class="item-list">
                    {
                        focus.items &&
                            focus.items.map((item) => (
                                <li>
                                    {item.svgPath && (
                                        <svg
                                            class="list-icon"
                                            aria-hidden="true"
                                            xmlns="http://www.w3.org/2000/svg"
                                            viewBox="0 0 640 640"
                                        >
                                            <path d={item.svgPath} />
                                        </svg>
                                    )}
                                    <div>
                                        <h3>{item.title}</h3>
                                        <p>{item.description}</p>
                                    </div>
                                </li>
                            ))
                    }
                </ul>
            </div>
        </section>

        <!-- Approach Section -->
        <section id="approach">
            <div class="container">
                <h2>{approach.title}</h2>
                <p class="section-subhead">{approach.subtitle}</p>
                <hr class="section-divider" />
                <ul class="item-list">
                    {
                        approach.items &&
                            approach.items.map((item) => (
                                <li>
                                    {item.svgPath && (
                                        <svg
                                            class="list-icon"
                                            aria-hidden="true"
                                            xmlns="http://www.w3.org/2000/svg"
                                            viewBox="0 0 640 640"
                                        >
                                            <path d={item.svgPath} />
                                        </svg>
                                    )}
                                    <div>
                                        <h3>{item.title}</h3>
                                        <p>{item.description}</p>
                                    </div>
                                </li>
                            ))
                    }
                </ul>
            </div>
        </section>

        <!-- Testimonial -->
        <section class="testimonial-section">
            <div class="container">
                <figure class="testimonial">
                    <blockquote>
                        <h3>
                            Alice is a calming, welcoming presence that offers
                            unique insight for the Asian-American community.
                        </h3>
                    </blockquote>
                    <figcaption class="testimonial-author">
                        <span class="label">Sade Ferrier</span>
                        <span class="small-text"
                            >Marriage &amp; Family Therapist, LMFT</span
                        >
                    </figcaption>
                </figure>
            </div>
        </section>

        <!-- Location & Availability Section -->
        <section id="location">
            <div class="container">
                <h2>{location.title}</h2>
                <p class="section-subhead">{location.subtitle}</p>
                <hr class="section-divider" />
                {location.introText && <p>{location.introText}</p>}

                {
                    location.details &&
                        location.details.map((block) => (
                            <>
                                <p class="label">{block.label}</p>
                                <p
                                    class="small-text"
                                    style="white-space: pre-line;"
                                >
                                    {block.text}
                                </p>
                            </>
                        ))
                }
            </div>
        </section>

        <!-- FAQs Section -->
        <section id="faqs">
            <div class="container">
                <h2>{faqs.title}</h2>
                <p class="section-subhead">{faqs.subtitle}</p>
                <hr class="section-divider" />

                {
                    faqs.questions &&
                        faqs.questions.map((faq) => (
                            <details>
                                <summary>{faq.question}</summary>
                                <div
                                    class="faq-answer"
                                    set:html={marked.parse(faq.answer)}
                                />
                            </details>
                        ))
                }
            </div>
        </section>

        <!-- Schedule Consultation Section -->
        <section id="consultation" class="section-schedule">
            <div class="container">
                <h2>{consultation.title}</h2>
                <p class="section-subhead">{consultation.subtitle}</p>
                <hr class="section-divider" />

                <div set:html={marked(consultation.description)} />

                {
                    consultation.showDisclaimer && (
                        <p class="small-text">{consultation.disclaimerText}</p>
                    )
                }

                <a
                    href={consultation.buttonUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn"
                >
                    {consultation.buttonText}
                </a>
            </div>
        </section>

        <!-- Footer Section -->
        <footer>
            <div class="container">
                <p class="label">{footer.contactLabel}</p>
                <address>
                    <a class="small-text" href={`mailto:${footer.email}`}>
                        {footer.email}
                    </a>
                </address>

                <p class="label">{footer.followLabel}</p>
                <a
                    class="small-text"
                    href={footer.socialUrl}
                    target="_blank"
                    rel="noopener"
                >
                    {footer.socialName}
                </a>

                <p class="xsmall-text">
                    &copy; <span id="year">{new Date().getFullYear()}</span> Maru
                    Psychotherapy LLC. All rights reserved.
                </p>
            </div>
        </footer>

        <script>
            // Dynamic copyright year
            document.getElementById("year").textContent =
                new Date().getFullYear();

            // Sticky header shadow effect
            const siteHeader = document.getElementById("siteHeader");
            window.addEventListener("scroll", () => {
                if (window.scrollY > 10) {
                    siteHeader.classList.add("scrolled");
                } else {
                    siteHeader.classList.remove("scrolled");
                }
            });

            // Smooth scroll for logo (back to top)
            document
                .getElementById("logoLink")
                .addEventListener("click", (e) => {
                    e.preventDefault();
                    window.scrollTo({
                        top: 0,
                        behavior: "smooth",
                    });
                });

            // Smooth scroll for site nav without changing URL hash
            document.querySelectorAll(".site-nav a").forEach((anchor) => {
                anchor.addEventListener("click", function (e) {
                    e.preventDefault();
                    const targetId = this.getAttribute("href");
                    const targetSection = document.querySelector(targetId);

                    if (targetSection) {
                        targetSection.scrollIntoView({
                            behavior: "smooth",
                        });
                    }
                });
            });
        </script>
    </body>
</html>
